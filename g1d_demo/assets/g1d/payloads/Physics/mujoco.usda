        def MjcActuator "Left_Wheel_Joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -13.962634086608887, -0.6981316804885864, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 8
            uniform double mjc:forceRange:min = -8
            uniform double[] mjc:gainPrm = [13.962634086608887, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </G1_D/Physics/Left_Wheel_Joint>
