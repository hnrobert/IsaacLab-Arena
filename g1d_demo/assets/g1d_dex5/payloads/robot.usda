#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "Dex5_URDF_R" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Dex5_URDF_R/root_joint>,
        </Dex5_URDF_R/joints/Roll_21R>,
        </Dex5_URDF_R/joints/Roll_31R>,
        </Dex5_URDF_R/joints/Roll_41R>,
        </Dex5_URDF_R/joints/Roll_51R>,
