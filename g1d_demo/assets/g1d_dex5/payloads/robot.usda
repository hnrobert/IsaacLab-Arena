        </Dex5_URDF_R/joints/Pitch_54R>,
        </Dex5_URDF_R/joints/Pitch_14R>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Dex5_URDF_R/base_link_R>,
        </Dex5_URDF_R/Link_21R>,
        </Dex5_URDF_R/Link_31R>,
        </Dex5_URDF_R/Link_41R>,
        </Dex5_URDF_R/Link_51R>,
        </Dex5_URDF_R/Link_11R>,
        </Dex5_URDF_R/Link_22R>,
        </Dex5_URDF_R/Link_32R>,
        </Dex5_URDF_R/Link_42R>,
        </Dex5_URDF_R/Link_52R>,
        </Dex5_URDF_R/Link_12R>,
        </Dex5_URDF_R/Link_23R>,
        </Dex5_URDF_R/Link_33R>,
        </Dex5_URDF_R/Link_43R>,
