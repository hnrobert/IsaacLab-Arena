#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/DefaultMaterial>
        }

        def Scope "VisualMaterials"
        {
            def Material "DefaultMaterial" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/DefaultMaterial>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_1/VisualMaterials/DefaultMaterial>
            token physics:approximation = "convexHull"
        }

        def Scope "VisualMaterials"
        {
            def Material "DefaultMaterial" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/DefaultMaterial>
            )
            {
            }
        }
    }

