        )
        {
            uniform token physics:approximation = "sdf"
            bool physics:collisionEnabled = 1
            quatf xformOp:orient = (-0.36109903, 7.9211775e-17, 0.9325275, 8.334328e-17)
            float3 xformOp:scale = (1, 0.94977194, 1)
            double3 xformOp:translate = (-1.1102230246251565e-16, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def PhysicsRevoluteJoint "RevoluteJoint_carton_1_right" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 110
            float drive:angular:physics:stiffness = 10
            float drive:angular:physics:targetPosition = 120
            uniform token drive:angular:physics:type = "acceleration"
            uniform token physics:axis = "Y"
            rel physics:body0 = </root/E_body_1>
            rel physics:body1 = </root/E_leaves_3_4>
            float physics:breakForce = inf
            float physics:breakTorque = inf
            point3f physics:localPos0 = (0.2700547, -0.0009094, 0.5311684)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
